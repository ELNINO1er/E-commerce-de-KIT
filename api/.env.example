APP_ENV=production
APP_URL=https://kic-fr.com
APP_KEY=REMPLACER_PAR_UNE_CLE_ALEATOIRE_D_AU_MOINS_32_CARACTERES
ALLOWED_ORIGINS=https://kic-fr.com,https://dashboard.kic-fr.com,http://localhost:4501

DB_HOST=localhost
DB_PORT=3306
DB_NAME=u000000000_kic
DB_USER=u000000000_kic
DB_PASSWORD=REMPLACER_CE_MOT_DE_PASSE

# Adresse interne qui reçoit une alerte à chaque nouvelle commande.
ORDER_NOTIFICATION_EMAIL=admin@kic-fr.com

# Stripe : commencer avec les clés de test sk_test_... et whsec_...
STRIPE_SECRET_KEY=sk_test_REMPLACER
STRIPE_WEBHOOK_SECRET=whsec_REMPLACER

# Paiement ouvert en mode test ; les clés live sont refusées en sandbox.
PAYMENTS_ENABLED=true
PAYMENT_MODE=sandbox
# Production : choisir TTC ou VAT_EXEMPT uniquement après validation comptable.
PRICE_TAX_MODE=UNCONFIRMED
SELLER_REGISTRATION=
SALES_TERMS_CONFIRMED=false
# Alerte facultative ; les messages sont toujours conservés dans le dashboard.
CONTACT_NOTIFICATION_EMAIL=
