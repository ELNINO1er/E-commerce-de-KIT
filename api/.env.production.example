# Valeurs à reporter dans le .env PRIVÉ de l'hébergement en conservant sa base et son APP_KEY.
# Ne jamais remplacer le .env existant par ce fichier incomplet.
APP_ENV=production
APP_URL=https://kic-fr.com
PAYMENTS_ENABLED=true
PAYMENT_MODE=live
STRIPE_SECRET_KEY=sk_live_REMPLACER
STRIPE_WEBHOOK_SECRET=whsec_REMPLACER
SELLER_REGISTRATION=100105154 RCS Nice
PRICE_TAX_MODE=TTC
# Taux transmis par KIC le 24/11/2026 ; 550 points de base = 5,5 %.
VAT_RATE_BPS=550
# Numéro communiqué par Jonathan ; statut VIES non vérifié.
SELLER_VAT_NUMBER=FR79100105154
# France métropolitaine et Corse uniquement, les autres zones gardent leur tarif.
DELIVERY_INCLUDED_FRANCE=true
# true seulement après validation des conditions réelles de vente et de livraison.
SALES_TERMS_CONFIRMED=false
