Options -Indexes
RewriteEngine On
RewriteRule ^(?:src|scripts|tests|migrations|storage)(?:/|$) - [F,L,NC]

# Les fichiers televerses restent servis directement par Apache.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.php [QSA,L]

<FilesMatch "^(\.env|config\.php|schema\.sql)$">
    Require all denied
</FilesMatch>

