Options -Indexes
RewriteEngine On

# Les fichiers televerses restent servis directement par Apache.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.php [QSA,L]

<FilesMatch "^(\.env|config\.php|schema\.sql)$">
    Require all denied
</FilesMatch>

